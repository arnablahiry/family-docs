<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes into Android's own cloud backup or device transfer: the vault key lives in the Keystore
     and can't move, so copied data would be unreadable. Use the app's encrypted Drive backup instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
